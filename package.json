{
  "name": "beledarians-markdown-editor",
  "description": "A personal, local-first Markdown editor with web, Tauri desktop, and experimental Android surfaces.",
  "homepage": "https://beledarian.github.io/beledarians-markdown-editor/",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "Beledarian",
  "repository": {
    "type": "git",
    "url": "https://github.com/Beledarian/beledarians-markdown-editor.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:verification": "vitest run src/tests/statePreservation.test.jsx src/tests/responsiveMatrix.test.js",
    "audit:design": "node scripts/audit-design-system.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "tauri build",
    "android:sync": "cap sync",
    "android:open": "cap open android",
    "android:build": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@uiw/react-md-editor": "^4.0.8",
    "baseline-browser-mapping": "^2.9.16",
    "diff": "^8.0.3",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.16.25",
    "mermaid": "^11.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "^4.18.11",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.13"
  }
}
