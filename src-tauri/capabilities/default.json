{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "win-*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-destroy",
    "core:webview:default",
    "core:path:default",
    "dialog:default",
    "fs:default",
    "shell:default",
    "log:default"
  ]
}
